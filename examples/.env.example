# ---- agent owners / peers
ALICE_OWNER_TOKEN=change-me-alice
BOB_OWNER_TOKEN=change-me-bob
AB_PEER_TOKEN=change-me-shared-alice-bob
# ---- gateway / pool
NIXIE_ADMIN_TOKEN=change-me-admin
NIXIE_BROWSER_POOL_TOKEN=change-me-pool
NIXIE_USERS_ROOT=/srv/nixie/users        # absolute host path, same inside gateway and on the docker host
# ---- models (OpenAI-compatible, in-house)
NIXIE_FAST_BASE_URL=
NIXIE_FAST_API_KEY=
NIXIE_FAST_MODEL=
NIXIE_PRO_BASE_URL=
NIXIE_PRO_API_KEY=
# ---- in-house services (empty = route not available)
HYNIX_ROOM_API=
HYNIX_HR_API=
HYNIX_APPROVAL_API=
HYNIX_SEARCH_API=
HYNIX_ITSM_API=
HYNIX_PORTAL_URL=
# legacy single-model setting (direct mode examples/alice.yaml, bob.yaml)
NIXIE_LLM_BASE_URL=
NIXIE_LLM_API_KEY=
NIXIE_LLM_MODEL=
