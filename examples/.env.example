# ---- edge proxy + SSO (oauth2-proxy, OIDC)
NIXIE_SERVER_NAME=nixie.example.internal
OAUTH2_PROXY_OIDC_ISSUER_URL=https://sso.example.internal/
OAUTH2_PROXY_CLIENT_ID=nixie
OAUTH2_PROXY_CLIENT_SECRET=change-me
OAUTH2_PROXY_REDIRECT_URL=https://nixie.example.internal/oauth2/callback
OAUTH2_PROXY_WHITELIST_DOMAINS=nixie.example.internal,sso.example.internal
# optional: full sign-out at the IdP after the proxy session is cleared (URL-encoded rd)
# NIXIE_LOGOUT_URL=/oauth2/sign_out?rd=https%3A%2F%2Fsso.example.internal%2Flogout
# ---- generated by `nixie pilot init --env-file .env` when empty:
#      NIXIE_SESSION_SECRET, NIXIE_PROXY_SECRET, NIXIE_ADMIN_TOKEN, NIXIE_BROWSER_POOL_TOKEN, OAUTH2_PROXY_COOKIE_SECRET
NIXIE_USERS_ROOT=/srv/nixie/users        # absolute host path, same inside gateway and on the docker host
# ---- models (OpenAI-compatible, in-house)
NIXIE_FAST_BASE_URL=
NIXIE_FAST_API_KEY=
NIXIE_FAST_MODEL=
NIXIE_PRO_BASE_URL=
NIXIE_PRO_API_KEY=
# ---- in-house services (empty = route not available)
HYNIX_ROOM_API=
HYNIX_HR_API=
HYNIX_APPROVAL_API=
HYNIX_SEARCH_API=
HYNIX_ITSM_API=
HYNIX_PORTAL_URL=
# ---- direct mode examples (examples/alice.yaml, bob.yaml, examples/users/*)
ALICE_OWNER_TOKEN=change-me-alice
BOB_OWNER_TOKEN=change-me-bob
AB_PEER_TOKEN=change-me-shared-alice-bob
NIXIE_LLM_BASE_URL=
NIXIE_LLM_API_KEY=
NIXIE_LLM_MODEL=
